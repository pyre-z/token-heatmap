# Token Heatmap 环境变量模板（复制为 .env 后填写真实值，.env 已被 gitignore）

# ===== 数据源 =====
# 数据源选择：new-api（默认）或 sub2api；未识别值会在启动时直接报错
SOURCE=new-api

# new-api（默认）: 直连 new-api PostgreSQL（只读）
PGHOST=__PG_HOST__
PGPORT=5432
PGDATABASE=new-api
PGUSER=__PG_USER__
PGPASSWORD=__PG_PASSWORD__

# 可选：sub2api 数据源（SOURCE=sub2api 时使用；独立变量避免与 new-api 混用）
# SUB2API_PGHOST=__SUB2API_PG_HOST__
# SUB2API_PGPORT=5432            # 可选，默认 5432
# SUB2API_PGDATABASE=__SUB2API_PG_DB__
# SUB2API_PGUSER=__SUB2API_PG_USER__
# SUB2API_PGPASSWORD=__SUB2API_PG_PASSWORD__

# ===== PostgreSQL 执行超时与 TLS（可选）=====
# 单条查询最大执行时间（毫秒），默认 5000；超时由 PostgreSQL 取消，避免慢查询拖垮连接池
DB_STATEMENT_TIMEOUT_MS=5000
# TLS：本地/Unix socket 无需设置；生产建议 verify-full 并挂载 CA 证书
# 取值：disable/allow/prefer/require/verify-ca/verify-full（未知值启动即报错）
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/etc/ssl/certs/pg-ca.crt
# SUB2API_PGSSLMODE=verify-full
# SUB2API_PGSSLROOTCERT=/etc/ssl/certs/sub2api-pg-ca.crt

# ===== 服务端缓存与并发 =====
# SVG 缓存 TTL（秒），必须为正数；默认 60
CACHE_TTL_SECONDS=60
# 缓存最大条目数，必须为正整数；默认 2000
CACHE_MAX_ENTRIES=2000
# 每进程同时执行渲染/查询的上限（保护数据库）；默认 4。公网限流仍建议在反向代理层配置
MAX_RENDER_CONCURRENCY=4

# ===== 部署 =====
# 容器所在外部网络（docker compose 网络插值；默认 proxy-network，
# 1Panel 等环境可设为对应外部网络名，如 1panel-network）
NETWORK_NAME=proxy-network
# 宿主监听端口（compose 端口映射使用）；默认 3004
HOST_PORT=3004

# 主题目录：默认项目根 themes/；容器内由 compose 覆盖（/themes 或 /app/themes），本地无需设置
# THEMES_DIR=
