# Token Heatmap 环境变量模板（复制为 .env 后填写真实值，.env 已被 gitignore）
# 数据源选择（SOURCE=new-api 默认；多源并存时部署多实例，各实例指定不同 SOURCE）

# ===== 数据源 =====
# new-api（默认）: 直连 new-api PostgreSQL（只读）
PGHOST=__PG_HOST__
PGPORT=5432
PGDATABASE=new-api
PGUSER=__PG_USER__
PGPASSWORD=__PG_PASSWORD__

# 可选：sub2api 数据源（SOURCE=sub2api 时使用；独立变量避免与 new-api 混用）
# SUB2API_PGHOST=__SUB2API_PG_HOST__
# SUB2API_PGPORT=5432
# SUB2API_PGDATABASE=__SUB2API_PG_DB__
# SUB2API_PGUSER=__SUB2API_PG_USER__
# SUB2API_PGPASSWORD=__SUB2API_PG_PASSWORD__

# 容器所在外部网络（docker compose 网络插值；默认 proxy-network，
# 1Panel 等环境可设为对应外部网络名，如 1panel-network）
NETWORK_NAME=proxy-network

# 服务端 SVG 缓存 TTL（秒），默认 60。TTL 内相同参数请求直接返回缓存，不查数据库
CACHE_TTL_SECONDS=60

# 主题目录（容器内 /themes = 项目根 themes/；watchdog 监听新增/删除/修改 *.json）
# 留空则默认项目根 themes/
THEMES_DIR=/themes
